# Copy to .env and fill in. NEVER commit .env or use a key that holds real funds.

# A funded TESTNET deployer key (a fresh burner). Fund it with Arc testnet gas at faucet.circle.com
PRIVATE_KEY=

# The Ledger Flex address that owns the vault + signs mandates (prod). Defaults to the deployer if unset.
GUARD_OWNER=

# Optional: a real USDC address on the target chain. If unset, a MockUSDC is deployed for testing.
USDC_ADDRESS=

# RPC overrides (defaults are set in hardhat.config.js)
ARC_TESTNET_RPC=https://rpc.testnet.arc.io
BASE_SEPOLIA_RPC=https://sepolia.base.org

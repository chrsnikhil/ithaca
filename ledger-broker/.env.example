# --- where the agent's fund-moving key lives at rest ---
# "keyring" = Ledger Key Ring (device-rooted, production).  "local" = AES-GCM passphrase (dev).
SECRET_BACKEND=local
AGENT_KEY_BLOB=./agent-key.json     # local: the sealed JSON blob.  keyring: the .enc file.
LOCAL_PASS=change-me                # local backend only
# WALLET_PASS=...                   # keyring backend: YOU provision this; the agent never sees it
# RING_KEY=guardian-agent          # keyring backend: the `wallet-cli ring` key name

# --- the ONLY thing the broker will ever sign (scope) ---
BROKER_VAULT=0x130E4D571eEa3928d11DC9d9c7C6561C55c6F2fd   # Guardian vault on Base Sepolia
BROKER_RPC=https://base-sepolia-rpc.publicnode.com

# --- local capability API ---
BROKER_PORT=8799
BROKER_TOKEN=change-me              # the daemon presents this; even with it, only scoped calls work

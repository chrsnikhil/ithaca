# Official Graph Gateway API key — create at https://thegraph.com/studio (first-party).
# Powers gateway subgraph queries (query_subgraph, get_token_price). Do NOT use a third-party service.
GRAPH_API_KEY=

# The wallet Guardian watches (the guarded position)
WATCH_ADDRESS=

# Optional RPC overrides for read_contract (defaults are public nodes)
ETH_RPC=https://ethereum-rpc.publicnode.com
BASE_RPC=https://base-rpc.publicnode.com
ARC_TESTNET_RPC=https://rpc.testnet.arc.io

# Optional — turn ON the real LLM reasoning loop (OpenAI-compatible; Groq = fast + free tier).
# Get a key at console.groq.com. Without it, `node agent.js` runs the deterministic tool demo.
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile
LLM_BASE_URL=https://api.groq.com/openai/v1
